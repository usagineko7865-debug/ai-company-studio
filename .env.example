# このファイルを ".env" という名前でコピーして使います(.env は GitHub に上げない)
# 初期状態は安全なモックモード(API を一切呼ばない)です。
USE_MOCK=true

# 実APIを使うときだけ設定します(USE_MOCK=false と、実行時の --real が両方必要)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# モデル名(2026-10-14 に公式ドキュメントで確認)
# OpenAI: gpt-6-luna = 現行の低価格モデル(推論はプログラム側でOFF)
# Anthropic: claude-haiku-5-5 = 最安のClaude(思考はプログラム側でOFF)
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_MODEL=claude-haiku-5-5

# 1回の実行あたりの予算上限(円)。初回テストは50円以内
MAX_BUDGET_JPY=50
# 為替レート(1ドル=何円)。現在のレートに合わせて更新してください
JPY_PER_USD=155

# 料金(USD / 100万トークン)。2026-10-14 時点の公式料金。変更されたら更新してください。
# OpenAI gpt-6-luna:  入力 0.10 / 出力 0.50
# Anthropic Haiku 5.5:  入力 0.10 / 出力 0.50 (プロンプトが10万トークン以下の場合。超えると5倍)
OPENAI_INPUT_USD_PER_M=0.10
OPENAI_OUTPUT_USD_PER_M=0.50
ANTHROPIC_INPUT_USD_PER_M=0.10
ANTHROPIC_OUTPUT_USD_PER_M=0.50

# 1回の応答の最大トークン数
MAX_OUTPUT_TOKENS=900
